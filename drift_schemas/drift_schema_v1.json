  "fixed_sql": [
    {
      "name": "pokemon",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon\" (\"id\" INTEGER NOT NULL CHECK(\"id\" > 0), \"national_number\" INTEGER NOT NULL CHECK(\"national_number\" > 0), \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") > 0), \"image_url\" TEXT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "type",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"type\" (\"id\" INTEGER NOT NULL CHECK(\"id\" > 0), \"name\" TEXT NOT NULL CHECK(LENGTH(\"name\") > 0) UNIQUE, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "pokemon_type",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"pokemon_type\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id) ON DELETE CASCADE, \"type_id\" INTEGER NOT NULL REFERENCES type (id), \"slot\" INTEGER NOT NULL CHECK(\"slot\" BETWEEN 1 AND 2), PRIMARY KEY (\"pokemon_id\", \"type_id\"), UNIQUE (\"pokemon_id\", \"slot\"));"
        }
      ]
    },
    {
      "name": "favorite",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"favorite\" (\"pokemon_id\" INTEGER NOT NULL REFERENCES pokemon (id), \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"pokemon_id\"));"
        }
      ]
    },
    {
      "name": "sync_metadata",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sync_metadata\" (\"resource_key\" TEXT NOT NULL CHECK(LENGTH(\"resource_key\") > 0), \"next_offset\" INTEGER NOT NULL DEFAULT 0 CHECK(\"next_offset\" >= 0), \"total_count\" INTEGER NULL CHECK(\"total_count\" >= 0), \"status\" TEXT NOT NULL DEFAULT 'idle' CHECK(\"status\" IN ('idle', 'syncing', 'success', 'failed')), \"last_success_at\" INTEGER NULL, \"last_error\" TEXT NULL, \"is_complete\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_complete\" IN (0, 1)), PRIMARY KEY (\"resource_key\"));"
        }
      ]
    },
    {
      "name": "pokemon_national_order",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX pokemon_national_order ON pokemon (national_number, id)"
        }
      ]
    },
    {
      "name": "favorite_creation_order",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE INDEX favorite_creation_order ON favorite (created_at, pokemon_id)"
        }
      ]
    }
  ]
